+test('host privacy policy consumes every external destination before any browser action', async () => {
+  const context = { fileName: 'private-file.hwp', sourceFormat: 'hwp' };
+  const received: string[] = [];
+  const fail = () => { assert.fail('External browser navigation must not run'); };
+  const actions = { anchor: () => true, web: fail, mail: fail, browserFallback: fail };
+  try {
+    setLinkHostHandler(destination => { received.push(destination.kind); return true; });
+    for (const kind of ['web', 'mail', 'relativeFile', 'localFile', 'registeredApplication'] as const) {
+      assert.equal(await navigateLink({ kind, uri: 'https://example.invalid/private-content' }, context, actions), true);
+    }
+    assert.deepEqual(received, ['web', 'mail', 'relativeFile', 'localFile', 'registeredApplication']);
+    assert.equal(await navigateLink({ kind: 'documentAnchor', uri: '#local' }, context, actions), true);
+    assert.equal(received.length, 5);
+  } finally { setLinkHostHandler(null); }
+});
